;; kanata config for EPOMAKER EK21 — three-layer tmux command surface
;; ============================================================
;; Architecture: pad -> usbipd -> kanata (cmd actions) -> tmux scripts
;;
;; Governing principles (see build prompt for full rationale):
;;   - The board stays dumb; logic lives here + in the megacat-* scripts.
;;     VIA only makes each physical key emit a distinct keysym.
;;   - kanata fires commands (cmd), never types keystrokes.
;;   - Scripts are Nix-defined (pkgs.writeShellApplication in home/kanata.nix)
;;     so shellcheck runs and runtime deps land on PATH.
;;   - Grab only the pad via linux-dev (udev symlink /dev/input/macropad).
;;
;; LAYER MODEL
;;   base  (default)            : the session map. Key N -> session N.
;;   read  (hold kprt, momentary): analyze the addressed session. fzf popups
;;                                that READ, never mutate.
;;   write (hold kp+, momentary) : alter the addressed session's state.
;;                                git/env/project ops that MUTATE.
;;
;; MODIFIER-HOLD SCHEME
;;   kprt held -> read layer   (lower tall right-column key)
;;   kp+  held -> write layer  (upper tall right-column key)
;;
;; TARGET MODEL (v1)
;;   Base makes session N the tmux current session (`switch-client -t N`).
;;   Read/write scripts resolve the addressed session as the *current* session
;;   via `tmux display-message -p '#{session_name}'` and cd into its pane path
;;   via `#{pane_current_path}'`, so repo ops hit the right repo even when fired
;;   from the pad.
;;
;;   SEAM (not built in v1): instead of resolving the addressed session as the
;;   visible current session, future work has Base write the desired target name
;;   to `~/.cache/megacat/target` and Read/Write read it. This lets the pad act
;;   on a session you are NOT currently looking at. Do not build yet.
;;
;; PHYSICAL LAYOUT (defsrc enumeration; ~4 extra-column [MINE] keys are NOT in
;; defsrc — wire them up after identifying their HID codes with
;; `evtest /dev/input/macropad`, then place @sk / @sr / @stub-mine on them):
;;
;;   tab   bspc  @help kp/  kp*  kp-
;;   kp7   kp8   kp9   kp+
;;   kp4   kp5   kp6
;;   kp1   kp2   kp3   kprt
;;   kp0                kp.
;;
;; RECYCLING / TODO MARKERS
;;   stubbed keys invoke `megacat-stub "<layer> <key>"`, which surfaces a
;;   tmux display-message so a press is visibly inert rather than confusingly
;;   silent. Fill the verb in by swapping the (cmd megacat-stub ...) for the
;;   real verb's alias; don't restructure.
;; ============================================================

(defcfg
  linux-dev @DEVICE_PATH@
  danger-enable-cmd yes
  linux-continue-if-no-devs-found yes
  process-unmapped-keys yes
  log-layer-changes yes
)

(defsrc
  tab   bspc  nlck  kp/   kp*   kp-
  kp7   kp8   kp9   kp+
  kp4   kp5   kp6
  kp1   kp2   kp3   kprt
  kp0               kp.
)

(defalias
  ;; ---- layer modifiers (momentary) ----------------------------
  ;; kprt held -> read layer.  kp+ held -> write layer.
  read-mod   (layer-while-held read)
  write-mod  (layer-while-held write)

  ;; ---- help (full pad reference; works from any layer) --------
  ;; Bound to nlck on base. nlck on read/write is `_` (transparent),
  ;; so it falls through to base -> @help fires from any active layer.
  help  (cmd "megacat-help")

  ;; ---- base: session map --------------------------------------
  ;; KP1..KP9 -> jump to session N (create-if-missing).
  s1   (cmd "megacat-session" "1")
  s2   (cmd "megacat-session" "2")
  s3   (cmd "megacat-session" "3")
  s4   (cmd "megacat-session" "4")
  s5   (cmd "megacat-session" "5")
  s6   (cmd "megacat-session" "6")
  s7   (cmd "megacat-session" "7")
  s8   (cmd "megacat-session" "8")
  s9   (cmd "megacat-session" "9")
  ;; KP0 -> fzf picker of all sessions (for >9).
  sp   (cmd "megacat-session-picker")
  ;; KP_Dot -> new detached session (popup prompts for name).
  sn   (cmd "megacat-session-new")

  ;; ---- [MINE] reserved verbs (NOT placed in deflayer; assign after
  ;; identifying the [MINE] physical keys with evtest and adding them to
  ;; defsrc). Defined so placement is one swap away. ----
  ;; sk   (cmd "megacat-session-kill")        ;; hold-to-confirm (wrap in tap-hold)
  ;; sr   (cmd "megacat-session-rename")      ;; popup prompts for new name

  ;; ---- read verbs (hold kprt) ---------------------------------
  rgst   (cmd "megacat-read-grep")        ;; KP7
  rchg   (cmd "megacat-read-changed")     ;; KP8
  rbr    (cmd "megacat-read-branches")    ;; KP9
  ;; remaining read digits: stubbed (megacat-stub "read <key>"); swap in
  ;; the real verb when finalizing. # EDIT

  ;; ---- write verbs (hold kp+) ----------------------------------
  wdots  (cmd "megacat-write-dots")       ;; KP1 — blind (safe + determinate)
  wcmt   (cmd "megacat-write-commit")     ;; KP2 — popup ($EDITOR msg)
  ;; KP3 — destructive (reset tree): tap-hold with tap=notify, hold=run, so a
  ;; stray tap is inert. tap-repress 0 disables the rapid-double-tap hold.
  wrst   (tap-hold 0 350
            (cmd "megacat-notify" "reset: hold to confirm")
            (cmd "megacat-write-reset"))
  ;; remaining write digits: stubbed (megacat-stub "write <key>"); swap in
  ;; the real verb when finalizing (build/test/compose/flake-update/rollback).
  ;; # EDIT
)

;; ============================================================
;; BASE layer (default) — the session map.
;;   tab bspc nlck kp/ kp* kp-  : transparent (passthrough)
;;   kp1..kp9                    : session jump (create-if-missing)
;;   kp0                         : fzf session picker
;;   kp.                         : new detached session (prompt)
;;   kprt                        : hold for READ layer
;;   kp+                         : hold for WRITE layer
;; ============================================================
(deflayer base
  _     _     @help _     _     _
  @s7   @s8   @s9   @write-mod
  @s4   @s5   @s6
  @s1   @s2   @s3   @read-mod
  @sp               @sn
)

;; ============================================================
;; READ layer (hold kprt) — analyze the addressed session.
;; Copies non-destructive popups (rg / git diff / branches). Every popup
;; targets the addressed session's attached client via -t "$(current)" so it
;; lands where you're looking.
;;
;; Bound verbs: KP7=grep  KP8=changed files  KP9=branches.
;; Remaining digits = stubbed with a marked TODO (# EDIT).
;; tab/bspc/nlck stay transparent so they keep working inside the popup's
;; shell when the popup is up.
;; ============================================================
(deflayer read
  _     _     _     _     _     _
  @rgst @rchg @rbr  XX
  (cmd "megacat-stub" "read kp4")  (cmd "megacat-stub" "read kp5")  (cmd "megacat-stub" "read kp6")
  (cmd "megacat-stub" "read kp1")  (cmd "megacat-stub" "read kp2")  (cmd "megacat-stub" "read kp3")  XX
  (cmd "megacat-stub" "read kp0")               (cmd "megacat-stub" "read kp.")
)

;; ============================================================
;; WRITE layer (hold kp+) — alter the addressed session's state.
;; Bound verbs: KP1=dots (blind)  KP2=commit (popup)  KP3=reset (hold-confirm).
;; Remaining digits = stubbed with a marked TODO (# EDIT):
;;   build / test / docker compose up-down / nix flake update / rollback.
;; Confirm logic for destructive verbs lives here (tap-hold), not scripts.
;; ============================================================
(deflayer write
  _     _     _     XX    _     _
  (cmd "megacat-stub" "write kp7")  (cmd "megacat-stub" "write kp8")  (cmd "megacat-stub" "write kp9")  XX
  (cmd "megacat-stub" "write kp4")  (cmd "megacat-stub" "write kp5")  (cmd "megacat-stub" "write kp6")
  @wdots  @wcmt  @wrst  XX
  (cmd "megacat-stub" "write kp0")               (cmd "megacat-stub" "write kp.")
)