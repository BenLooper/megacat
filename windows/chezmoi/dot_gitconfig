[init]
  defaultBranch = main

[pull]
  rebase = true

[diff]
  algorithm = histogram

[status]
  showUntrackedFiles = all

[credential]
  helper = !gh auth git-credential

[core]
  excludesfile = ~/.config/git/ignore

[alias]
  st = status
  co = checkout
  br = branch
  ci = commit
  lg = log --oneline --graph --decorate --all
  undo = reset --soft HEAD~1
  changed = diff-tree --no-commit-id -r --name-only HEAD
