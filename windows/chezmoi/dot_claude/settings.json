{
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& \\\"$env:USERPROFILE\\.local\\scripts\\agent-notify.ps1\\\" claude done\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& \\\"$env:USERPROFILE\\.local\\scripts\\agent-notify.ps1\\\" claude attention\""
          }
        ]
      }
    ]
  }
}
